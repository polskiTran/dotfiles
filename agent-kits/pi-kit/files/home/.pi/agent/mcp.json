{
    "mcpServers": {
    "playwright": {
        "command": "npx",
        "args": [
        "-y",
        "@playwright/mcp@0.0.78",
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox"
        ],
        "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/home/agent/.cache/ms-playwright"
        },
        "exposure": "codemode"
    }
    }
}
